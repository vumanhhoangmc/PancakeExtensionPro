{
  "manifest_version": 3,
  "name": "Pancake Assistant Pro",
  "version": "0.10.0",
  "description": "DEV: Bố Hoàng No1",
  "permissions": ["storage", "activeTab", "alarms", "nativeMessaging"],
  "background": { "service_worker": "update-worker.js" },
  "host_permissions": ["https://pancake.vn/*", "https://*.pancake.vn/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://pancake.vn/*", "https://*.pancake.vn/*"],
      "js": ["product-summary.js", "pricing.js", "content.js", "comment-reply.js", "comment-followup.js", "chat-reader.js", "ai-order-plan.js", "ai-order-dom.js", "chat-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://pos.pancake.vn/shop/*/order*"],
      "js": ["pos-groups.js", "pos-content.js"],
      "css": ["pos-content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Pancake Assistant Pro",
    "default_popup": "popup.html"
  }
}
